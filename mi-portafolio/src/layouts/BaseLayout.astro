---
import "../shared/styles/tokens.css";
import "../shared/styles/base.css";
import "../shared/styles/section.css";
import { profile } from "../ducks/profile/index.js";

const { title = profile.documentTitle, description = profile.description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7a8b8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..700&family=Press+Start+2P&family=Syne:wght@500..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <div class="stage">
      <slot />
    </div>
    <script>
      import "../scripts/header.js";
      import "../scripts/reveal.js";
      import "../scripts/section-nav.js";
    </script>
  </body>
</html>
