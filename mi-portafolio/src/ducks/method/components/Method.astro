---
import SectionHeading from "../../../shared/components/SectionHeading.astro";
import { steps } from "../index.js";
import "../styles/method.css";
---

<section class="section" id="metodo" aria-labelledby="metodo-titulo">
  <div class="shell">
    <SectionHeading
      id="metodo-titulo"
      eyebrow="Método"
      title="De la idea a una pantalla que se puede usar."
      text="El mismo recorrido en cada proyecto: entender, ordenar, construir y revisar el detalle."
    />
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step" data-reveal style={`--delay:${index * 70}ms`}>
            <p class="step__number">{step.number}</p>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
